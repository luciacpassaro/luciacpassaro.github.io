@inproceedings{11568_1217988,
 abstract = {This paper introduces CheckIT!, a resource of expert fact-checked claims, filling a gap for the development of fact-checking pipelines in Italian. We further investigate the use of three state-of-the-art generative text models to create variations of claims in zero-shot settings as a data-augmentation strategy for the identification of previously fact-checked claims. Our results indicate that models struggles in varying the surface forms of the claims.},
 address = {Aachen},
 author = {Gili, J. and Passaro, L. and Caselli, T.},
 booktitle = {Proceedings of the 9th Italian Conference on Computational Linguistics},
 isbn = {979-12-5500-084-6},
 keywords = {Corpora,Data augmentation,Fact-checking,Generative AI Model Evaluation},
 pages = {227--235},
 publisher = {CEUR-WS},
 title = {{{CheckIT}}!: A Corpus of Expert Fact-Checked Claims for Italian},
 volume = {3596},
 year = {2023}
}

